# Google Calendar availability (see README "Availability calendar").
# Leave blank and the calendar still works, it just won't grey out booked days.
PUBLIC_GCAL_ID=
PUBLIC_GCAL_KEY=

# Enquiry form via Web3Forms (needed on Cloudflare Pages; leave blank on Netlify to use Netlify Forms).
# Get a free access key at https://web3forms.com using thesmallcardoc@gmail.com.
PUBLIC_WEB3FORMS_KEY=

# Booking system (Google Apps Script web app URL ending in /exec). See apps-script/SETUP.md.
# When set, enquiries go to it (Accept/Decline emails, Google Calendar, bank-transfer emails)
# and the website calendar reads booked dates from it. Web3Forms stays as the backup.
PUBLIC_BOOKINGS_URL=
