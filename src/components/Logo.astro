---
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<span class={`logo ${cls}`}>
  <!-- Trailer with a classic Volvo estate on the deck (same drawing as the Google profile logo) -->
  <svg class="logo-mark" viewBox="62 160 598 198" aria-hidden="true" focusable="false">
    <path d="M236 252 L236 222 Q236 214 246 214 L330 210 L356 172 Q358 168 364 168 L596 168 Q604 168 606 176 L612 210 Q614 214 614 222 L614 252 Q614 262 604 262 L246 262 Q236 262 236 252 Z" fill="currentColor"/>
    <rect x="226" y="236" width="16" height="13" rx="3" fill="currentColor"/>
    <rect x="608" y="236" width="16" height="13" rx="3" fill="currentColor"/>
    <path d="M352 206 L369 178 L430 178 L430 206 Z" fill="var(--logo-bg, #f5f0e6)"/>
    <path d="M440 178 L510 178 L510 206 L440 206 Z" fill="var(--logo-bg, #f5f0e6)"/>
    <path d="M520 178 L592 178 L597 206 L520 206 Z" fill="var(--logo-bg, #f5f0e6)"/>
    <rect x="246" y="226" width="358" height="3" rx="1.5" fill="var(--logo-bg, #f5f0e6)"/>
    <circle cx="303" cy="254" r="31" fill="var(--logo-bg, #f5f0e6)"/>
    <circle cx="512" cy="254" r="31" fill="var(--logo-bg, #f5f0e6)"/>
    <rect x="70" y="300" width="34" height="18" rx="9" fill="currentColor"/>
    <path d="M98 302 L202 288 L202 306 L98 317 Z" fill="currentColor"/>
    <rect x="128" y="276" width="24" height="10" rx="4" fill="currentColor"/>
    <rect x="134" y="280" width="12" height="52" rx="4" fill="currentColor"/>
    <circle cx="140" cy="338" r="15" fill="currentColor"/><circle cx="140" cy="338" r="5" fill="var(--logo-bg, #f5f0e6)"/>
    <rect x="182" y="250" width="12" height="44" rx="4" fill="currentColor"/>
    <circle cx="188" cy="254" r="15" fill="currentColor"/><circle cx="188" cy="254" r="5" fill="var(--logo-bg, #f5f0e6)"/>
    <rect x="198" y="262" width="12" height="40" rx="3" fill="currentColor"/>
    <rect x="198" y="280" width="454" height="22" rx="5" fill="currentColor"/>
    <rect x="640" y="264" width="12" height="38" rx="3" fill="currentColor"/>
    <circle cx="303" cy="254" r="25" fill="currentColor"/>
    <circle cx="303" cy="254" r="10" fill="var(--logo-bg, #f5f0e6)"/>
    <circle cx="512" cy="254" r="25" fill="currentColor"/>
    <circle cx="512" cy="254" r="10" fill="var(--logo-bg, #f5f0e6)"/>
    <circle cx="387" cy="322" r="30" fill="currentColor"/>
    <circle cx="387" cy="322" r="13" fill="var(--logo-bg, #f5f0e6)"/>
    <circle cx="387" cy="322" r="6" fill="currentColor"/>
    <circle cx="463" cy="322" r="30" fill="currentColor"/>
    <circle cx="463" cy="322" r="13" fill="var(--logo-bg, #f5f0e6)"/>
    <circle cx="463" cy="322" r="6" fill="currentColor"/>
  </svg>
  <span class="logo-text"><span>Exeter</span> Trailer Hire</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--forest);
  }
  .logo-mark {
    width: auto;
    height: 30px;
    flex: none;
  }
  @media (max-width: 380px) {
    .logo-mark {
      height: 24px;
    }
  }
  .logo-text {
    white-space: nowrap;
  }
  @media (max-width: 360px) {
    .logo {
      gap: 0.4rem;
      font-size: 1rem;
    }
    .logo-mark {
      height: 20px;
    }
  }
  .logo-text {
    color: var(--ink);
  }
  .logo-text span {
    color: var(--forest);
  }
</style>
